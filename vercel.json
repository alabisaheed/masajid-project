{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/login",
      "has": [{ "type": "host", "value": "dashboard.masajidproject.org" }],
      "dest": "/login/index.html"
    },
    {
      "src": "/dashboard(.*)",
      "has": [{ "type": "host", "value": "dashboard.masajidproject.org" }],
      "dest": "/dashboard/index.html"
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "dashboard.masajidproject.org" }],
      "dest": "/dashboard/index.html"
    },
    { "src": "/dashboard", "dest": "/dashboard/index.html" },
    { "src": "/admin", "dest": "/dashboard/index.html" },
    { "src": "/login", "dest": "/login/index.html" },
    { "src": "/projects", "dest": "/projects.html" },
    { "src": "/project-detail", "dest": "/project-detail.html" },
    { "src": "/transparency", "dest": "/transparency.html" },
    { "src": "/about", "dest": "/about.html" },
    { "src": "/blog", "dest": "/blog.html" },
    { "src": "/blog-post", "dest": "/blog-post.html" },
    { "src": "/faq", "dest": "/faq.html" },
    { "src": "/submit", "dest": "/submit.html" },
    { "src": "/donate", "dest": "/donate.html" },
    { "src": "/privacy", "dest": "/privacy.html" },
    { "src": "/terms", "dest": "/terms.html" },
    { "src": "/blog/(.*)", "dest": "/blog-post.html" },
    { "src": "/(css|js|images|data|fonts|icons)/(.*)", "dest": "/$1/$2" },
    { "src": "/(favicon.ico|favicon.svg|robots.txt|sitemap.xml)", "dest": "/$1" },
    { "src": "/([^/]+)", "dest": "/blog-post.html" }
  ]
}
